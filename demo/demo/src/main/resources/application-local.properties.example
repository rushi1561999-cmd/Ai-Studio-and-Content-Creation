# Copy this file to application-local.properties. The copied file is ignored by Git.

spring.datasource.password=your_local_mysql_password
jwt.secret=base64_encoded_secret_with_at_least_32_bytes

ai.gemini.api.key=your_gemini_api_key
replicate.api.token=your_replicate_token
ai.image.fallback.enabled=true

stripe.api.key=your_stripe_test_key
stripe.webhook.secret=your_stripe_test_webhook_secret
razorpay.api.key=your_razorpay_test_key
razorpay.api.secret=your_razorpay_test_secret
razorpay.webhook.secret=your_razorpay_webhook_secret

app.frontend.url=http://localhost:5173
app.cors.allowed-origins=http://localhost:5173
app.email.enabled=false
app.dev.manual-topup.enabled=true

# Optional one-time local admin seed. Disable it after the account exists.
app.admin.seed.enabled=false
app.admin.email=admin@example.com
app.admin.password=replace_with_a_strong_local_password
app.admin.name=Platform Admin
