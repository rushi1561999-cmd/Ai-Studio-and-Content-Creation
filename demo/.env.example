# Copy to .env in the project root before: docker compose up --build

JWT_SECRET=generate-a-unique-random-value-of-at-least-32-characters
MYSQL_USER=aistudio_app
MYSQL_PASSWORD=replace-with-a-strong-unique-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
RABBITMQ_USER=aistudio_worker
RABBITMQ_PASSWORD=replace-with-a-strong-unique-password

# At least one AI provider is required for real generation.
GEMINI_API_KEY=
REPLICATE_API_TOKEN=

# Configure either gateway. A gateway is enabled only when its webhook secret is also set.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_API_KEY=
RAZORPAY_API_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional transactional email.
APP_EMAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional one-time admin bootstrap; disable after the account exists.
APP_ADMIN_SEED_ENABLED=false
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=
APP_ADMIN_NAME=Platform Admin
